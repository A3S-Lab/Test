{
  "name": "@a3s-lab/testkit",
  "version": "0.4.1",
  "description": "Embedded page context and human review SDK for A3S Test",
  "keywords": [
    "a3s",
    "agentic-testing",
    "browser-testing",
    "human-review",
    "vibe-coding"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A3S-Lab/Test.git",
    "directory": "packages/testkit"
  },
  "homepage": "https://a3s-lab.github.io/Test/guide/testkit.html",
  "bugs": {
    "url": "https://github.com/A3S-Lab/Test/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "audit:check": "node scripts/check-screen-reader-audit.mjs",
    "audit:screen-reader": "node scripts/serve-screen-reader-audit.mjs",
    "build": "tsup",
    "check:package": "node scripts/check-package.mjs && tsc -p scripts/tsconfig.json",
    "test": "npm run test:node && vitest run src",
    "test:node": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.27.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "modern-screenshot": "^4.7.0"
  }
}
