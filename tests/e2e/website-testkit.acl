suite "website-testkit-experience" {
    version = 1

    scenario "single-and-batch-review" {
        name = "Review rendered page context and submit local findings"
        surface = "web"
        timeout_ms = 90000

        viewport "desktop" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-homepage" {
            url = "http://127.0.0.1:4173/Test/"
        }

        wait "homepage-ready" {
            text = "让 Agent 看懂页面"
        }

        expect "published-install-version" {
            text = "CLI + Agent Skill · v0.16.2"
        }

        expect "motion-sequence-active" {
            visible = css(".test-experience-stage.is-motion-active")
        }

        click "pause-motion-sequence" {
            target = role("button", "暂停自动演示")
        }

        wait "motion-sequence-paused" {
            visible = css(".test-motion-toggle[aria-pressed='true']")
        }

        click "resume-motion-sequence" {
            target = role("button", "继续自动演示")
        }

        wait "motion-sequence-resumed" {
            visible = css(".test-motion-toggle[aria-pressed='false']")
        }

        wheel "show-release-disclosure" {
            delta_y = 900
        }

        expect "release-candidate-disclosure" {
            text = "当前文档已进入下一版本准备阶段"
        }

        wheel "return-to-testkit" {
            delta_y = -900
        }

        expect "local-only-disclosure" {
            text = "这个演示只保存在当前页面"
        }

        expect "rendered-context" {
            text = "a3s-experience-submit"
        }

        click "open-review" {
            target = role("button", "打开点选模式")
        }

        wait "overlay-mounted" {
            text = "点选模式已打开"
        }

        snapshot "overlay-controls" {
            interactive = true
        }

        press "mark-single" {
            key = "e"
        }

        snapshot "single-marking-state" {
            interactive = true
        }

        click "choose-submit-action" {
            target = testid("a3s-experience-submit")
        }

        snapshot "single-editor" {
            interactive = true
        }

        fill "single-instruction" {
            target = label("希望如何修改")
            value = "Increase the action label contrast without changing layout"
        }

        snapshot "single-editor-filled" {
            interactive = true
        }

        click "send-single" {
            target = role("button", "发送并自动修复")
        }

        wait "single-receipt" {
            text = "1 个标记"
        }

        snapshot "after-single" {
            interactive = true
        }

        press "mark-first-batch-item" {
            key = "e"
        }

        snapshot "first-batch-marking-state" {
            interactive = true
        }

        click "choose-context-refresh" {
            target = role("button", "刷新")
        }

        snapshot "first-batch-editor" {
            interactive = true
        }

        fill "first-batch-instruction" {
            target = label("希望如何修改")
            value = "Clarify the context refresh state"
        }

        snapshot "first-batch-editor-filled" {
            interactive = true
        }

        click "save-first-batch-draft" {
            target = role("button", "加入草稿")
        }

        snapshot "after-first-batch-draft" {
            interactive = true
        }

        press "mark-second-batch-item" {
            key = "e"
        }

        snapshot "second-batch-marking-state" {
            interactive = true
        }

        click "choose-install-copy" {
            target = role("button", "复制命令")
        }

        snapshot "second-batch-editor" {
            interactive = true
        }

        fill "second-batch-instruction" {
            target = label("希望如何修改")
            value = "Announce which installer command was copied"
        }

        snapshot "second-batch-editor-filled" {
            interactive = true
        }

        click "save-second-batch-draft" {
            target = role("button", "加入草稿")
        }

        snapshot "batch-ready" {
            interactive = true
        }

        click "send-batch" {
            target = role("button", "发送选中项（2）")
        }

        wait "batch-receipt" {
            text = "2 个标记"
        }

        screenshot "review-evidence" {
            path = "screenshots/website-testkit.png"
        }

        accessibility "semantic-evidence" {
            path = "evidence/accessibility.json"
            interactive = false
        }

        console "console-evidence" {
            path = "evidence/console.json"
            clear = false
        }

        page_errors "page-error-evidence" {
            path = "evidence/page-errors.json"
            clear = false
        }
    }

    scenario "mobile-review-surface" {
        name = "Use the embedded review controls on a narrow viewport"
        surface = "web"
        timeout_ms = 60000

        viewport "mobile" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-mobile-homepage" {
            url = "http://127.0.0.1:4173/Test/"
        }

        wait "mobile-homepage-ready" {
            text = "让 Agent 看懂页面"
        }

        expect "mobile-rendered-context" {
            text = "a3s-experience-submit"
        }

        click "mobile-open-review" {
            target = role("button", "打开点选模式")
        }

        wait "mobile-overlay-mounted" {
            text = "点选模式已打开"
        }

        snapshot "mobile-overlay-controls" {
            interactive = true
        }

        press "mobile-open-layout" {
            key = "l"
        }

        snapshot "mobile-layout-controls" {
            interactive = true
        }

        click "mobile-open-component-catalog" {
            target = role("button", "组件目录 · 90")
        }

        snapshot "mobile-component-catalog-open" {
            interactive = true
        }

        fill "mobile-search-component-catalog" {
            target = role("searchbox", "搜索组件目录")
            value = "结账"
        }

        wait "mobile-chinese-component-result" {
            visible = role("button", "结账表单")
        }

        click "mobile-choose-chinese-component" {
            target = role("button", "结账表单")
        }

        snapshot "mobile-localized-layout-component" {
            interactive = true
        }

        screenshot "mobile-layout-evidence" {
            path = "screenshots/website-testkit-mobile.png"
        }

        accessibility "mobile-semantic-evidence" {
            path = "evidence/accessibility-mobile.json"
            interactive = false
        }

        console "mobile-console-evidence" {
            path = "evidence/console-mobile.json"
            clear = false
        }

        page_errors "mobile-page-error-evidence" {
            path = "evidence/page-errors-mobile.json"
            clear = false
        }
    }
}
